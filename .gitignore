# Generated by Cargo
# will have compiled files and executables
/target/
debug/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Test artefacts
proptest-regressions/

# Editor noise
.idea/
.vscode/
*.swp
*~

# macOS
.DS_Store

# Local build helper (retry wrapper) and its log — not for the repo.
.build.sh
.build.log

# NOTE: Cargo.lock IS committed for this crate — CI runs every gate with
# --locked, which needs the lockfile present on a fresh checkout.
